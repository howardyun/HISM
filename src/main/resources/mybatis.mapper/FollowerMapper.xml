<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org/DTD Mapper 3.0" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.HISM.backfront.mapper.FollowerMapper">
    <resultMap id="followerMap" type="com.HISM.backfront.domain.Follower">
        <result column="followTime" jdbcType="TIMESTAMP" property="followTime" javaType="java.util.Date" />
    </resultMap>

<!--插入follower-->
    <insert id="insertFollower">
        insert into follower value (#{followerId}, #{userId}, #{followTime})
    </insert>
<!--删除了follower-->
    <delete id="deleteFollower">
        delete from follower where followerId = #{followerId} and userId = #{userId}
    </delete>
<!--获取粉丝id-->
    <select id="getFan" resultMap="followerMap">
        select followerId from follower where userId = #{userId1}
    </select>
<!--获取关注者id-->
    <select id="getSubscriber" resultMap="followerMap">
        select userId from follower where followerId = #{userId2}
    </select>


</mapper>