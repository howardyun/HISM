<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org/DTD Mapper 3.0" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.HISM.backfront.mapper.TipOffDynamicMapper">
    <resultMap id="tipOffDynamicMap" type="com.HISM.backfront.domain.TipOffDynamic">
        <result column="tipOffTime" jdbcType="TIMESTAMP" property="tipOffTime" javaType="java.util.Date" />
    </resultMap>


    <insert id="insertTipOff">
        insert into tipOffDynamic value (#{dynamicId}, #{informerId}, #{tipOffTime, jdbcType=DATE}, #{tipOffContent}, #{isValid})
    </insert>

    <update id="updateTipOff">
        update tipOffdynamic set tipOffTime = #{tipOffTime}, tipOffContent = #{tipOffContent}, isValid = #{isValid}
        where dynamicId = #{dynamicId} and informerId = #{informerId}
    </update>

    <select id="selectTipOffByDynamicId" resultMap="tipOffDynamicMap">
        select * from tipOffDynamic where dynamicId = #{dynamicId}
    </select>
</mapper>